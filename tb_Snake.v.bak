`timescale 1ns/1ps

module tb_Snake();
    reg master_clk;
    reg KB_clk;
    reg data;
    reg start;
    
    wire [9:0] VGA_R, VGA_G, VGA_B;
    wire VGA_hSync, VGA_vSync;
    wire DAC_clk, blank_n, sync_n;
	 
	 wire [9:0] LEDR;
    wire [6:0] HEX0; 
    wire [6:0] HEX1;

    snake uut (
        .master_clk(master_clk),
        .KB_clk(KB_clk),
        .data(data),
        .start(start),
		  
        .VGA_R(VGA_R),
        .VGA_G(VGA_G),
        .VGA_B(VGA_B),
		  
        .VGA_hSync(VGA_hSync),
        .VGA_vSync(VGA_vSync),
        .DAC_clk(DAC_clk),
        .blank_n(blank_n),
        .sync_n(sync_n),
		  
		  .LEDR(LEDR),
        .HEX0(HEX0),
        .HEX1(HEX1)
    );

    always #10 master_clk = ~master_clk;

    initial begin

        master_clk = 0;
        KB_clk = 1;
        data = 1;
        start = 0;

        #100;
        start = 1; 

        #40000000; 
        
        $stop; 
    end

endmodule