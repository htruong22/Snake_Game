transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/Snake_Top.v}
vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/VGA_Controller.v}
vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/Game_Clock.v}
vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/Random_Generator.v}
vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/Keyboard_Controller.v}
vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/Hex_Decoder.v}
vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/GameOver_Display.v}

vlog -vlog01compat -work work +incdir+E:/CE213/Project_Final {E:/CE213/Project_Final/tb_Snake.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneii_ver -L rtl_work -L work -voptargs="+acc"  tb_Snake

add wave *
view structure
view signals
run -all
